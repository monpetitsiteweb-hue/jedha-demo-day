# ─── Savvy Crypto ML Service — variables d'environnement ─────────────────────
# Copiez ce fichier en `.env` et renseignez vos vraies valeurs.
# NE JAMAIS committer le vrai `.env` (il est ignoré par .gitignore).

# URL du projet Supabase (héberge le bucket Storage "ml-models")
# Format : https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Clé Supabase service_role (JWT) utilisée pour télécharger les modèles
# depuis le bucket privé "ml-models" au démarrage.
# À générer dans Supabase > Project Settings > API. NE JAMAIS exposer publiquement.
SUPABASE_KEY=your-supabase-service-role-key

# (Optionnel) Répertoire local où les modèles sont téléchargés au démarrage.
# Défaut : ./models  (dans le Dockerfile : /app/models)
MODELS_DIR=./models

# (Optionnel) Port d'écoute HTTP. Railway l'injecte automatiquement.
# Défaut : 8000
PORT=8000
